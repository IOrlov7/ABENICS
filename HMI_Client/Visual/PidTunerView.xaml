<UserControl x:Class="HMI_Client.Visual.PidTunerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ЛЕВАЯ ПАНЕЛЬ: Ползунки -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="PID Тюнер — Ось X (Pitch)" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>

                <!-- Outer PID -->
                <GroupBox Header="Внешний контур (IMU → Энкодер)">
                    <StackPanel>
                        <DockPanel Margin="2"><TextBlock Text="Kp" Width="30"/>
                            <Slider x:Name="Sl_OX_Kp" Minimum="0" Maximum="10" Value="1.5" TickFrequency="0.1" IsSnapToTickEnabled="True"/>
                            <TextBlock Text="{Binding Value, ElementName=Sl_OX_Kp, StringFormat=F2}" Width="40" TextAlignment="Right"/></DockPanel>
                        <DockPanel Margin="2"><TextBlock Text="Ki" Width="30"/>
                            <Slider x:Name="Sl_OX_Ki" Minimum="0" Maximum="5" Value="0.1" TickFrequency="0.01" IsSnapToTickEnabled="True"/>
                            <TextBlock Text="{Binding Value, ElementName=Sl_OX_Ki, StringFormat=F2}" Width="40" TextAlignment="Right"/></DockPanel>
                        <DockPanel Margin="2"><TextBlock Text="Kd" Width="30"/>
                            <Slider x:Name="Sl_OX_Kd" Minimum="0" Maximum="2" Value="0.05" TickFrequency="0.01" IsSnapToTickEnabled="True"/>
                            <TextBlock Text="{Binding Value, ElementName=Sl_OX_Kd, StringFormat=F2}" Width="40" TextAlignment="Right"/></DockPanel>
                    </StackPanel>
                </GroupBox>

                <!-- Inner PID -->
                <GroupBox Header="Внутренний контур (Энкодер → Мотор)">
                    <StackPanel>
                        <DockPanel Margin="2"><TextBlock Text="Kp" Width="30"/>
                            <Slider x:Name="Sl_IX_Kp" Minimum="0" Maximum="20" Value="2.0" TickFrequency="0.1" IsSnapToTickEnabled="True"/>
                            <TextBlock Text="{Binding Value, ElementName=Sl_IX_Kp, StringFormat=F2}" Width="40" TextAlignment="Right"/></DockPanel>
                        <DockPanel Margin="2"><TextBlock Text="Ki" Width="30"/>
                            <Slider x:Name="Sl_IX_Ki" Minimum="0" Maximum="10" Value="0.5" TickFrequency="0.05" IsSnapToTickEnabled="True"/>
                            <TextBlock Text="{Binding Value, ElementName=Sl_IX_Ki, StringFormat=F2}" Width="40" TextAlignment="Right"/></DockPanel>
                        <DockPanel Margin="2"><TextBlock Text="Kd" Width="30"/>
                            <Slider x:Name="Sl_IX_Kd" Minimum="0" Maximum="2" Value="0.0" TickFrequency="0.01" IsSnapToTickEnabled="True"/>
                            <TextBlock Text="{Binding Value, ElementName=Sl_IX_Kd, StringFormat=F2}" Width="40" TextAlignment="Right"/></DockPanel>
                        <DockPanel Margin="2"><TextBlock Text="Kff" Width="30"/>
                            <Slider x:Name="Sl_IX_Kff" Minimum="0" Maximum="1" Value="0.3" TickFrequency="0.05" IsSnapToTickEnabled="True"/>
                            <TextBlock Text="{Binding Value, ElementName=Sl_IX_Kff, StringFormat=F2}" Width="40" TextAlignment="Right"/></DockPanel>
                    </StackPanel>
                </GroupBox>

                <!-- Target -->
                <GroupBox Header="Целевое положение">
                    <StackPanel>
                        <DockPanel Margin="2"><TextBlock Text="Pitch" Width="40"/>
                            <TextBox x:Name="TxtPitch" Text="0.0" Width="60"/></DockPanel>
                        <DockPanel Margin="2"><TextBlock Text="Roll" Width="40"/>
                            <TextBox x:Name="TxtRoll" Text="0.0" Width="60"/></DockPanel>
                        <Button Content="Применить" Click="BtnApplyTarget_Click" Margin="0,5,0,0"/>
                    </StackPanel>
                </GroupBox>

                <Button Content="Отправить все коэффициенты" Click="BtnSendAll_Click"
                        Margin="0,10,0,0" Padding="5" FontWeight="Bold"/>
            </StackPanel>
        </ScrollViewer>

        <!-- ПРАВАЯ ПАНЕЛЬ: График -->
        <Border Grid.Column="1" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Margin="10,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="8,4">
                    <TextBlock Text="📈 Отклик каскада — Ось X (Pitch)" FontSize="12" FontWeight="SemiBold" Foreground="#1976D2"/>
                </Border>
                <lvc:CartesianChart x:Name="PidChart" Grid.Row="1" Margin="4"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
