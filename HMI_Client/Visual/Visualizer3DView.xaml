<!-- File: HMI_Client/Visual/Visualizer3DView.xaml 
UserControl для 3D-модели.-->
<UserControl x:Class="HMI_Client.Visual.Visualizer3DView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:h="clr-namespace:HelixToolkit.Wpf;assembly=HelixToolkit.Wpf"
             mc:Ignorable="d" 
             d:DesignHeight="400" d:DesignWidth="400">
    <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Margin="8">
        <h:HelixViewport3D x:Name="Viewport3D" Background="White" ShowCoordinateSystem="True" CoordinateSystemLabelForeground="#333333" ZoomExtentsWhenLoaded="True">
            <h:SunLight/>
            <h:DefaultLights/>
            <h:GridLinesVisual3D Width="8" Length="8" MinorDistance="0.5" MajorDistance="1" Thickness="0.005" Fill="#E0E0E0"/>

            <ModelVisual3D x:Name="ImuModel">
                <ModelVisual3D.Content>
                    <Model3DGroup>
                        <!-- Основной корпус -->
                        <GeometryModel3D>
                            <GeometryModel3D.Geometry>
                                <MeshGeometry3D Positions="-2,-0.1,-1.5  2,-0.1,-1.5  2,0.1,-1.5 -2,0.1,-1.5  -2,-0.1, 1.5  2,-0.1, 1.5  2,0.1, 1.5 -2,0.1, 1.5"
                                                TriangleIndices="0,1,2 0,2,3  4,6,5 4,7,6  0,4,5 0,5,1  2,6,7 2,7,3  0,3,7 0,7,4  1,5,6 1,6,2"/>
                            </GeometryModel3D.Geometry>
                            <GeometryModel3D.Material><DiffuseMaterial Brush="#2E7D32"/></GeometryModel3D.Material>
                        </GeometryModel3D>
                        <!-- Деталь 1 (Черная) -->
                        <GeometryModel3D>
                            <GeometryModel3D.Geometry>
                                <MeshGeometry3D Positions="-0.8,0.1,-0.8  0.8,0.1,-0.8  0.8,0.3,-0.8 -0.8,0.3,-0.8  -0.8,0.1, 0.8  0.8,0.1, 0.8  0.8,0.3, 0.8 -0.8,0.3, 0.8"
                                                TriangleIndices="0,1,2 0,2,3  4,6,5 4,7,6  0,4,5 0,5,1  2,6,7 2,7,3  0,3,7 0,7,4  1,5,6 1,6,2"/>
                            </GeometryModel3D.Geometry>
                            <GeometryModel3D.Material><DiffuseMaterial Brush="#212121"/></GeometryModel3D.Material>
                        </GeometryModel3D>
                        <!-- Деталь 2 (Желтая, ось X) -->
                        <GeometryModel3D>
                            <GeometryModel3D.Geometry>
                                <MeshGeometry3D Positions="1.2,0.1,-1  1.5,0.1,-1  1.5,0.25,-1 1.2,0.25,-1  1.2,0.1,-0.7  1.5,0.1,-0.7  1.5,0.25,-0.7 1.2,0.25,-0.7"
                                                TriangleIndices="0,1,2 0,2,3  4,6,5 4,7,6  0,4,5 0,5,1  2,6,7 2,7,3  0,3,7 0,7,4  1,5,6 1,6,2"/>
                            </GeometryModel3D.Geometry>
                            <GeometryModel3D.Material><DiffuseMaterial Brush="#FFC107"/></GeometryModel3D.Material>
                        </GeometryModel3D>
                    </Model3DGroup>
                </ModelVisual3D.Content>
                <!-- Группа трансформаций для вращения по кватерниону -->
                <ModelVisual3D.Transform>
                    <Transform3DGroup>
                        <RotateTransform3D x:Name="ImuRotation"/>
                    </Transform3DGroup>
                </ModelVisual3D.Transform>
            </ModelVisual3D>
            <h:CoordinateSystemVisual3D/>
        </h:HelixViewport3D>
    </Border>
</UserControl>