<Window x:Class="IMU_Visualizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:h="clr-namespace:HelixToolkit.Wpf;assembly=HelixToolkit.Wpf"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        Title="IMU 3D Visualizer"
        Height="900"
        Width="1050"
        Background="#F5F5F5"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- верхняя панель -->
            <RowDefinition Height="*"/>
            <!-- 3D-вьюпорт -->
            <RowDefinition Height="Auto"/>
            <!-- данные -->
            <RowDefinition Height="200"/>
            <!-- ГРАФИКИ -->
            <RowDefinition Height="120"/>
            <!-- лог -->
            <RowDefinition Height="Auto"/>
            <!-- статус-бар -->
        </Grid.RowDefinitions>

        <!-- ═══ Верхняя панель управления (БЕЗ ИЗМЕНЕНИЙ) ═══ -->
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#E0E0E0"
                BorderThickness="0,0,0,1"
                Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Строка 1: Подключение -->
                <StackPanel Grid.Row="0"
                            Orientation="Horizontal">
                    <TextBlock Text="🔌 Подключение"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#333333"
                               VerticalAlignment="Center"
                               Margin="0,0,16,0"/>

                    <ComboBox x:Name="CmbPort"
                              Width="100"
                              Margin="0,0,8,0"
                              ToolTip="Выберите COM-порт"/>

                    <Button Content="Подключить"
                            Click="BtnComOpen_Click"
                            Width="100"
                            Margin="0,0,8,0"
                            Background="#4CAF50"
                            Foreground="White"
                            BorderThickness="0"
                            Padding="8,6"
                            Cursor="Hand"
                            ToolTip="Открыть COM-порт"/>

                    <Button Content="Отключить"
                            Click="BtnComClose_Click"
                            Width="100"
                            Margin="0,0,8,0"
                            Background="#F44336"
                            Foreground="White"
                            BorderThickness="0"
                            Padding="8,6"
                            Cursor="Hand"
                            ToolTip="Закрыть COM-порт"/>

                    <TextBlock x:Name="TxtStatus"
                               Text="⚪ Отключено"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#757575"
                               VerticalAlignment="Center"
                               Margin="16,0,0,0"/>

                    <Line X1="0"
                            Y1="0"
                            X2="0"
                            Y2="24"
                          Stroke="#E0E0E0"
                          StrokeThickness="1"
                          Margin="16,0,16,0"
                          VerticalAlignment="Center"/>

                    <TextBlock Text="🔧 Режим:"
                               FontSize="13"
                               Foreground="#555555"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>

                    <Button Content="0 - Serial Only"
                            Click="BtnMode0_Click"
                            Width="120"
                            Margin="0,0,4,0"
                            Background="#9E9E9E"
                            Foreground="White"
                            BorderThickness="0"
                            Padding="4,3"
                            Cursor="Hand"
                            ToolTip="Режим только по COM-порту"/>

                    <Button Content="1 - WiFi AP"
                            Click="BtnMode1_Click"
                            Width="100"
                            Margin="0,0,4,0"
                            Background="#2196F3"
                            Foreground="White"
                            BorderThickness="0"
                            Padding="4,3"
                            Cursor="Hand"
                            ToolTip="Режим WiFi как точка доступа"/>

                    <Button Content="2 - WiFi STA"
                            Click="BtnMode2_Click"
                            Width="100"
                            Margin="0,0,4,0"
                            Background="#4CAF50"
                            Foreground="White"
                            BorderThickness="0"
                            Padding="4,3"
                            Cursor="Hand"
                            ToolTip="Режим WiFi как клиент"/>

                    <Button Content="🔄 Обновить"
                            Click="BtnRefreshPorts_Click"
                            Width="80"
                            Background="#FF9800"
                            Foreground="White"
                            BorderThickness="0"
                            Padding="4,3"
                            Cursor="Hand"
                            ToolTip="Обновить список COM-портов"/>
                </StackPanel>

                <!-- Строка 2: UDP настройки -->
                <StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            Margin="0,12,0,0">
                    <TextBlock Text="🌐 UDP:"
                               FontSize="13"
                               Foreground="#555555"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>

                    <TextBlock Text="Порт:"
                               VerticalAlignment="Center"
                               Foreground="#666666"
                               Margin="0,0,4,0"/>
                    <TextBox x:Name="TxtUdpPort"
                             Text="8888"
                             Width="60"
                             Margin="0,0,16,0"
                             ToolTip="UDP порт для приёма данных"/>

                    <TextBlock Text="IP ПК:"
                               VerticalAlignment="Center"
                               Foreground="#666666"
                               Margin="0,0,4,0"/>
                    <TextBox x:Name="TxtPcIp"
                             Text="192.168.10.18"
                             Width="130"
                             Margin="0,0,8,0"
                             ToolTip="IP адрес вашего компьютера"/>
                    <Button Content="🔌 Connect to AP"
                            Click="BtnConnectToAP_Click"
                            Width="130"
                            Margin="0,0,8,0"
                            Background="#9C27B0"
                            Foreground="White"
                            BorderThickness="0"
                            Padding="8,6"
                            Cursor="Hand"
                            ToolTip="Подключиться к ESP32 в режиме AP (192.168.4.1)"/>

                    <Button Content="Отправить IP на ESP32"
                            Click="BtnSendIpToEsp_Click"
                            Width="150"
                            Margin="0,0,8,0"
                            Background="#2196F3"
                            Foreground="White"
                            BorderThickness="0"
                            Padding="8,6"
                            Cursor="Hand"
                            ToolTip="Отправить IP адрес на ESP32"/>

                    <Button Content="💾 Сохранить"
                            Click="BtnSave_Click"
                            Width="100"
                            Margin="0,0,8,0"
                            Background="#009688"
                            Foreground="White"
                            BorderThickness="0"
                            Padding="8,6"
                            Cursor="Hand"/>

                    <Button Content="🔄 Сброс"
                            Click="BtnReset_Click"
                            Width="80"
                            Background="#FF9800"
                            Foreground="White"
                            BorderThickness="0"
                            Padding="8,6"
                            Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ 3D-вьюпорт (БЕЗ ИЗМЕНЕНИЙ) ═══ -->
        <Border Grid.Row="1"
                Margin="8"
                Background="White"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                CornerRadius="4">
            <h:HelixViewport3D x:Name="Viewport3D"
                               Background="White"
                               ShowCoordinateSystem="True"
                               CoordinateSystemLabelForeground="#333333"
                               ZoomExtentsWhenLoaded="True">

                <h:SunLight/>
                <h:DefaultLights/>

                <h:GridLinesVisual3D Width="8"
                                     Length="8"
                                     MinorDistance="0.5"
                                     MajorDistance="1"
                                     Thickness="0.005"
                                     Fill="#E0E0E0"/>

                <ModelVisual3D x:Name="ImuModel">
                    <ModelVisual3D.Content>
                        <Model3DGroup>
                            <GeometryModel3D>
                                <GeometryModel3D.Geometry>
                                    <MeshGeometry3D
                                        Positions="-2,-0.1,-1.5  2,-0.1,-1.5  2,0.1,-1.5 -2,0.1,-1.5
                                                   -2,-0.1, 1.5  2,-0.1, 1.5  2,0.1, 1.5 -2,0.1, 1.5"
                                        TriangleIndices="0,1,2 0,2,3  4,6,5 4,7,6
                                                         0,4,5 0,5,1  2,6,7 2,7,3
                                                         0,3,7 0,7,4  1,5,6 1,6,2"/>
                                </GeometryModel3D.Geometry>
                                <GeometryModel3D.Material>
                                    <DiffuseMaterial Brush="#2E7D32"/>
                                </GeometryModel3D.Material>
                            </GeometryModel3D>

                            <GeometryModel3D>
                                <GeometryModel3D.Geometry>
                                    <MeshGeometry3D
                                        Positions="-0.8,0.1,-0.8  0.8,0.1,-0.8  0.8,0.3,-0.8 -0.8,0.3,-0.8
                                                   -0.8,0.1, 0.8  0.8,0.1, 0.8  0.8,0.3, 0.8 -0.8,0.3, 0.8"
                                        TriangleIndices="0,1,2 0,2,3  4,6,5 4,7,6
                                                         0,4,5 0,5,1  2,6,7 2,7,3
                                                         0,3,7 0,7,4  1,5,6 1,6,2"/>
                                </GeometryModel3D.Geometry>
                                <GeometryModel3D.Material>
                                    <DiffuseMaterial Brush="#212121"/>
                                </GeometryModel3D.Material>
                            </GeometryModel3D>

                            <GeometryModel3D>
                                <GeometryModel3D.Geometry>
                                    <MeshGeometry3D
                                        Positions="1.2,0.1,-1  1.5,0.1,-1  1.5,0.25,-1 1.2,0.25,-1
                                                   1.2,0.1,-0.7  1.5,0.1,-0.7  1.5,0.25,-0.7 1.2,0.25,-0.7"
                                        TriangleIndices="0,1,2 0,2,3  4,6,5 4,7,6
                                                         0,4,5 0,5,1  2,6,7 2,7,3
                                                         0,3,7 0,7,4  1,5,6 1,6,2"/>
                                </GeometryModel3D.Geometry>
                                <GeometryModel3D.Material>
                                    <DiffuseMaterial Brush="#FFC107"/>
                                </GeometryModel3D.Material>
                            </GeometryModel3D>

                            <GeometryModel3D>
                                <GeometryModel3D.Geometry>
                                    <MeshGeometry3D
                                        Positions="-1.5,0.1,0.8  -1.2,0.1,0.8  -1.2,0.2,0.8 -1.5,0.2,0.8
                                                   -1.5,0.1,1  -1.2,0.1,1  -1.2,0.2,1 -1.5,0.2,1"
                                        TriangleIndices="0,1,2 0,2,3  4,6,5 4,7,6
                                                         0,4,5 0,5,1  2,6,7 2,7,3
                                                         0,3,7 0,7,4  1,5,6 1,6,2"/>
                                </GeometryModel3D.Geometry>
                                <GeometryModel3D.Material>
                                    <DiffuseMaterial Brush="#424242"/>
                                </GeometryModel3D.Material>
                            </GeometryModel3D>

                            <GeometryModel3D>
                                <GeometryModel3D.Geometry>
                                    <MeshGeometry3D
                                        Positions="-2,0.1,-0.2  -1.8,0.1,-0.2  -1.8,0.4,-0.2 -2,0.4,-0.2
                                                   -2,0.1,0.2  -1.8,0.1,0.2  -1.8,0.4,0.2 -2,0.4,0.2"
                                        TriangleIndices="0,1,2 0,2,3  4,6,5 4,7,6
                                                         0,4,5 0,5,1  2,6,7 2,7,3
                                                         0,3,7 0,7,4  1,5,6 1,6,2"/>
                                </GeometryModel3D.Geometry>
                                <GeometryModel3D.Material>
                                    <DiffuseMaterial Brush="#FFA000"/>
                                </GeometryModel3D.Material>
                            </GeometryModel3D>
                        </Model3DGroup>
                    </ModelVisual3D.Content>
                </ModelVisual3D>

                <h:CoordinateSystemVisual3D/>
            </h:HelixViewport3D>
        </Border>

        <!-- ═══ Панель данных (БЕЗ ИЗМЕНЕНИЙ) ═══ -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E0E0E0"
                BorderThickness="0,1,0,0"
                Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Roll (X)"
                               FontSize="11"
                               Foreground="#757575"
                               Margin="0,0,0,2"/>
                    <TextBlock x:Name="TxtRoll"
                               Text="0.0°"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#1976D2"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="Pitch (Y)"
                               FontSize="11"
                               Foreground="#757575"
                               Margin="0,0,0,2"/>
                    <TextBlock x:Name="TxtPitch"
                               Text="0.0°"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#388E3C"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Yaw (Z)"
                               FontSize="11"
                               Foreground="#757575"
                               Margin="0,0,0,2"/>
                    <TextBlock x:Name="TxtYaw"
                               Text="0.0°"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#D32F2F"/>
                </StackPanel>

                <StackPanel Grid.Column="3">
                    <TextBlock Text="Температура"
                               FontSize="11"
                               Foreground="#757575"
                               Margin="0,0,0,2"/>
                    <TextBlock x:Name="TxtTemp"
                               Text="-- °C"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#F57C00"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ ГРАФИКИ (НОВОЕ) ═══ -->
        <Grid Grid.Row="3"
                Margin="8,8,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- График акселерометра -->
            <Border Grid.Column="0"
                    Background="White"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    CornerRadius="4"
                    Margin="0,0,4,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="#F5F5F5"
                            BorderBrush="#E0E0E0"
                            BorderThickness="0,0,0,1"
                            Padding="8,4">
                        <TextBlock Text="📊 Акселерометр (m/s²)"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#1976D2"/>
                    </Border>

                    <lvc:CartesianChart Grid.Row="1"
                                        x:Name="AccelChart"
                                        Margin="4"/>
                </Grid>
            </Border>

            <!-- График гироскопа -->
            <Border Grid.Column="1"
                    Background="White"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    CornerRadius="4"
                    Margin="4,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="#F5F5F5"
                            BorderBrush="#E0E0E0"
                            BorderThickness="0,0,0,1"
                            Padding="8,4">
                        <TextBlock Text="📊 Гироскоп (°/s)"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#D32F2F"/>
                    </Border>

                    <lvc:CartesianChart Grid.Row="1"
                                        x:Name="GyroChart"
                                        Margin="4"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══ Лог (БЕЗ ИЗМЕНЕНИЙ) ═══ -->
        <Border Grid.Row="4"
                Margin="8,8,8,8"
                Background="#263238"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                CornerRadius="4">
            <TextBox x:Name="TxtLog"
                     FontFamily="Consolas"
                     FontSize="11"
                     Background="Transparent"
                     Foreground="#81C784"
                     BorderThickness="0"
                     IsReadOnly="True"
                     VerticalScrollBarVisibility="Auto"
                     Text="Лог инициализации..."
                     Padding="8"/>
        </Border>

        <!-- ═══ Статус-бар (БЕЗ ИЗМЕНЕНИЙ) ═══ -->
        <Border Grid.Row="5"
                Background="#424242"
                Padding="12,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="IMU 3D Visualizer v1.0"
                           Foreground="#BDBDBD"
                           FontSize="11"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1"
                           x:Name="TxtPacketRate"
                           Text="0 Hz"
                           Foreground="#81C784"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Margin="0,0,16,0"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="2"
                           x:Name="TxtLastPacket"
                           Text="Последний пакет: --"
                           Foreground="#BDBDBD"
                           FontSize="11"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>